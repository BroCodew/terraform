# Copy to terraform.tfvars when you want to override defaults locally.

aws_region    = "ap-southeast-1"
instance_type = "t3.micro"
key_name      = "your-ssh-key-name"

common_tags = {
  Environment = "tr"
  ManagedBy   = "terraform"
}

